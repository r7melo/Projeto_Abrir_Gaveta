<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- Valores copiados de Partner Center > Identidade do Produto.
       Se o Python instalado for 32 bits, troque x64 por x86. -->
  <Identity
    Name="ANTONIOROMARIOCARLOSDEMEL.AbrirGavetaPDV"
    Publisher="CN=6F9368AA-FD35-4CBA-A142-E08828C35C4D"
    Version="1.0.4.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Abrir Gaveta PDV</DisplayName>
    <PublisherDisplayName>MelusDev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="AbrirGaveta" Executable="abrir_gaveta.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Abrir Gaveta PDV"
        Description="Abre a gaveta de dinheiro conectada à impressora térmica com um clique."
        BackgroundColor="#1E40AF"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Permite iniciar com o Windows (desligado por padrão; o usuário ativa em
             Configurações > Aplicativos > Inicialização). Fica só em segundo plano. -->
        <uap5:Extension Category="windows.startupTask" Executable="gaveta_inicio.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="AbrirGavetaInicio" Enabled="false" DisplayName="Abrir Gaveta PDV" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
